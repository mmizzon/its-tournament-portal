package it.its.tornei.dto;

import it.its.tornei.model.Utente;

import java.time.LocalDateTime;

public record UtenteResponse(
        Integer id,
        String nome,
        String cognome,
        String email,
        String ruolo,
        LocalDateTime dataRegistrazione
) {
    public static UtenteResponse da(Utente u) {
        return new UtenteResponse(
                u.getId(), u.getNome(), u.getCognome(), u.getEmail(),
                u.getRuolo().name().toLowerCase(), u.getDataRegistrazione());
    }
}
