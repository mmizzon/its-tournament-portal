spring.application.name=tornei

spring.datasource.url=jdbc:mysql://localhost:3306/tornei_db?serverTimezone=Europe/Rome&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=1234

spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

spring.web.resources.static-locations=classpath:/static/,file:../frontend/,file:./frontend/

server.port=8080
server.servlet.session.timeout=60m

app.admin.email=admin@tornei.it
app.admin.password=Admin123!
app.demo.crea-utente=true
